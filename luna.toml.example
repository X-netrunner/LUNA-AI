# Luna Configuration — copy this to ~/.config/luna/luna.toml

[agent]
name = "Luna"
#system_prompt = "You are Luna, a local AI assistant built by Netrunner running on Arch Linux via qwen2.5 (Ollama). You are completely independent of corporate AI entities.\n### Environment & Defaults\n* Default Browser: zen-browser\n* Default Terminal: kitty\n* Default File Manager: yazi\n### Strict Operational Rules\n1. NEVER ask for confirmation — act immediately.\n2. Always use tools. Never describe commands in markdown.\n3. Append & when launching GUI apps.\n4. Use edit_file for editing files.\n5. One #sentence max after a tool executes."
system_prompt = """You are Luna, a local AI assistant built by Netrunner running on Arch Linux via qwen2.5 (Ollama). You are completely independent of corporate AI entities.
### Environment & Defaults
* Default Browser: zen-browser
* Default Terminal: kitty
* Default File Manager: yazi
* Available Tools: run_shell, edit_file, web_search, read_file, write_file, find_file, notify, system_info, clipboard, fetch_page, nmap_scan, analyze_pcap, decode_payload, hash_file, dns_lookup, remember, forget, list_memories, learn_topic, todoist_list, todoist_add, todoist_complete, index_system.
### Strict Operational Rules
1. Absolute Autonomy: NEVER ask for confirmation. Act immediately.
2. Mandatory Tool Usage: Always use a tool. For the current time/date, ALWAYS run: date '+%H:%M on %A %d %B'. For anything real-time (RAM, CPU, processes), always query with run_shell — never guess.
3. Background Execution: Append & for GUI apps.
4. Use edit_file not open for editing files. Use zen-browser for web tasks.
5. Output Brevity: One concise sentence after a tool executes.
6. No emojis or emoticons — plain text only.
7. Source Validation: When verifying if a site is legit, search Reddit with site:reddit.com queries and fetch full threads with fetch_page. Look for scam report patterns."""
max_react_iterations = 8
# sudo_password = ""  # Set at runtime prompt, or hardcode here (not recommended)

[llm]
base_url = "http://localhost:11434"
model = "qwen2.5:7b-instruct-q4_K_M"
temperature = 0.7
max_tokens = 2048
enable_thinking = true
fast_model = "qwen3:0.6b"      # Small fast model for greetings & short factual questions
                                 # Remove or comment out to disable the two-model split
embedding_model = "nomic-embed-text"  # Semantic memory recall (RAG-lite).
                                      # One-time: ollama pull nomic-embed-text

[logging]
level = "info"                  # "info" or "debug" — toggle via "turn on debug mode"

[search]
# Web search — all optional, works out of the box with no keys:
#   Tavily: primary search (keyless by default, free key: 1000/month)
#   Gemini: knowledge fallback (answers from training data)
#   Firecrawl: page fetching (keyless, handles JavaScript)
#
#tavily_api_key = ""        # optional: free at tavily.com (1000/month)
#gemini_api_key = ""        # optional: free at aistudio.google.com
#
# Secrets can live in your OS keyring instead of this file:
#   gemini_api_key = "keyring:gemini"
#   tavily_api_key = "keyring:tavily"
#   todoist api_token = "keyring:todoist"
# Store them securely (prompts without echo):
#   luna --set-key gemini
# Luna also chmods this file to 600 on save.

[todoist]
api_token = "your_token_here"

[proactive]
enabled = true
check_interval_mins = 15
battery_low_threshold = 20
disk_full_threshold = 90
check_updates = true

[daemon]
# Background watchdog — run with: luna --daemon
# Install as a service: cp deploy/luna-daemon.service ~/.config/systemd/user/
#                       systemctl --user enable --now luna-daemon
enabled = true
check_interval_mins = 30

# Process watchdog: flags RAM/CPU hogs via desktop notification.
# NEVER kills anything automatically — you decide what to end.
ram_threshold_mb = 1500        # single process using more than this (MiB)
cpu_threshold_percent = 80.0   # sustained CPU% since last scan
ignore_processes = ["ollama", "luna", "plasmashell", "kwin_wayland",
                    "gnome-shell", "Xwayland", "pipewire", "wireplumber"]

# Usage learning: the daemon tracks which processes run on which days.
# Apps seen on >= daily_use_days_per_week of the last 7 days are treated
# as daily drivers — they stop triggering resource notifications, and are
# never auto-killed. State persists in ~/.local/share/luna/process_stats.json.
learning_enabled = true
daily_use_days_per_week = 5

# Idle processes: allowlisted ones get SIGTERM after idle_kill_minutes,
# then SIGKILL next scan if still alive. Everything else only earns an
# opt-in suggestion after suggest_autokill_after_mins (once per day).
# Manage via chat: 'process stats', 'allow auto-kill steam',
#                  'deny auto-kill steam'
idle_kill_minutes = 30
suggest_autokill_after_mins = 45

# Stateful apps that must NEVER be auto-killed, even when allowlisted
protected_processes = ["firefox", "zen-browser", "chromium", "code", "zed",
                       "kitty", "alacritty", "konsole", "foot", "obs",
                       "gimp", "krita", "blender", "libreoffice", "soffice",
                       "thunderbird", "discord", "telegram-desktop", "slack"]

# How often (days) Luna re-analyzes fish history into permanent memory
history_learn_days = 30
# How often (days) Luna re-indexes projects/scripts/configs (0 = off)
index_learn_days = 30

# Disk hygiene: pacman cache, ~/.cache, trash, journals.
# cleanup_mode:
#   notify = only report reclaimable space (default, safe)
#   auto   = actually clean when / crosses disk_full_threshold above
disk_cleanup = true
cleanup_mode = "notify"
cache_max_age_days = 30        # delete ~/.cache files untouched this long
trash_max_age_days = 14        # empty trash items older than this
journal_vacuum_days = 30       # journalctl --vacuum-time (needs sudo)
pacman_cache_keep = 2          # paccache -rkN (needs sudo)
min_notify_mb = 500            # only report cleanups worth this much

[voice]
mode = "basic"              # basic | off
piper_bin = "af_heart"      # Kokoro voice: af_heart | af_sky | af_nicole | af_sarah
piper_model = "/home/YOUR_USERNAME/.local/share/luna/kokoro/kokoro-v1.0.onnx"
whisper_model = "/home/YOUR_USERNAME/.local/share/luna/models/ggml-small.en.bin"

[audio]
input_mode = "wake_word"    # off | wake_word | both
wake_word = "hello luna"
wake_aliases = ["luna", "hey luna", "hello luna", "hay luna"]
vad_silence_ms = 800
sample_rate = 16000

[memory]
context_window = 6
history_path = "/home/YOUR_USERNAME/.local/share/luna/history.json"
