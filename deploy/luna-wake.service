# Luna wake-word daemon — systemd *user* service
#
# Always-on "hey luna" listener: sleeps until the wake word is heard, then
# starts Luna in the configured mode (headless voice session by default, or a
# TUI window when [wake] launch_mode = "tui") and drives the on-screen
# listening indicator (native Wayland layer-shell overlay).
#
# Install:
#   cargo build --release
#   install -Dm755 target/release/luna ~/.local/bin/luna
#   mkdir -p ~/.config/systemd/user
#   cp deploy/luna-wake.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now luna-wake
#
# Logs:
#   journalctl --user -u luna-wake -f

[Unit]
Description=Luna wake-word daemon ("hey luna" + listening overlay)
Wants=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/luna --wake-daemon
Restart=always
RestartSec=5
# launch_mode = "tui" spawns a terminal running the full TUI. Kill only our
# own process on stop/restart so that terminal (and the user's work in it)
# survives luna-wake service restarts.
KillMode=process

[Install]
WantedBy=default.target