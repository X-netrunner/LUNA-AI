# Luna background daemon — systemd *user* service
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/luna-daemon.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now luna-daemon
#
# Logs:
#   journalctl --user -u luna-daemon -f

[Unit]
Description=Luna background watchdog (process + disk monitoring)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.cargo/bin/luna --daemon
Restart=on-failure
RestartSec=10
# notify-send needs the session bus — systemd user units inherit it,
# but be explicit so it also works under `machinectl shell` sessions.
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus

[Install]
WantedBy=graphical-session.target
